GITWISE_ENV=development
GITWISE_LOG_LEVEL=INFO
GITWISE_API_HOST=127.0.0.1
GITWISE_API_PORT=8000
# Optional PostgreSQL URL for Alembic and the snapshot store.
# Use a secret manager in deployed environments; never commit real credentials.
GITWISE_DATABASE_URL=postgresql+asyncpg://gitwise:change-me@localhost:5432/gitwise

# Optional GitHub App webhook secret; keep the production value in a secret manager.
GITWISE_GITHUB_WEBHOOK_SECRET=

# Optional GitHub App credentials. Store the private key in a secret manager in production.
GITWISE_GITHUB_APP_ID=
GITWISE_GITHUB_APP_PRIVATE_KEY=

# Fernet keys (comma-separated, newest first) that encrypt stored GitHub user tokens.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the real value in a secret manager; add the new key at the front to rotate.
GITWISE_TOKEN_ENCRYPTION_KEYS=
